#!/bin/bash
[[ ! -x "$0" ]] && chmod +x "$0"

export LC_ALL=C

if [[ -z "${skip_banner+x}" ]]; then
    skip_banner=0
fi

# A security workflow to discover real-world threats

function yublueflower_banner() {
    echo -e "\033[36m"  
    cat << "EOF"
       .   .-~\
      /'.'   `-:
      | /       `._
      || .-.      {
      |\ `-'       `.
   .  \|            /   yublueflower v0.0.3 (latest)
 ~-.`.\\|        .-~_
    `.\-\     .-~   \
      `-'\~~.~      /
    .-~/|`-/~-.~--~
   /  |  \   ~-_\
EOF
    echo -e "\033[0m"  
    echo "Tagline          : A security workflow to discover real-world threats"
    echo "Author           : 1337rokudenashi"
    echo "Architecture     : $(lsb_release -ds) ($(uname -m))"
    echo "Time             : $(date '+%Y-%m-%d %H:%M:%S')"
    echo "Uptime           : $(uptime -p | sed 's/up //')"
    echo ""
}

function yublueflower_env() {
    local required_commands=(
        bash chmod cp mkdir rm wget tar sed grep gawk perl cut sort tee
        timeout xargs realpath date uptime uname lsb_release clear
    )
    local missing_commands=()

    for command_name in "${required_commands[@]}"; do
        if ! command -v "$command_name" >/dev/null 2>&1; then
            missing_commands+=("$command_name")
        fi
    done

    if (( ${#missing_commands[@]} > 0 )); then
        echo "Missing required system dependencies:"
        for command_name in "${missing_commands[@]}"; do
            echo "  - $command_name"
        done
        echo ""
        echo "Please install the missing packages using your system package manager."
        echo ""
        echo "Debian / Ubuntu / Kali Linux:"
        echo "  apt install -y wget perl gawk coreutils findutils tar xz-utils lsb-release"
        echo ""
        echo "Note:"
        echo "  Root privileges may be required."
        exit 1
    fi

    local yublueflower_root="$HOME/yublueflower"
    local yublueflower_env="$yublueflower_root/yublueflower-env"
    yublueflower="$HOME/.local/bin/yublueflower"
    path=$(realpath "$0")
    [[ "$path" != "$yublueflower" ]] && mkdir -p "$HOME/.local/bin" && cp "$path" "$yublueflower" && chmod +x "$yublueflower"

    if ! grep -q "export PATH=\$HOME/.local/bin:\$PATH" ~/.profile; then
        echo "export PATH=\$HOME/.local/bin:\$PATH" >> ~/.profile
    fi

    node_version=$(node -v 2>/dev/null | sed 's/v//')
    required_node_version="24.16.0"

    if [[ -z "$node_version" ]] || [[ "$(printf '%s\n' "$node_version" "$required_node_version" | sort -V | tail -n1)" != "$node_version" ]]; then
        echo "Installing node.js v$required_node_version"

        wget -q https://nodejs.org/dist/v24.16.0/node-v24.16.0-linux-x64.tar.xz -O /tmp/node.tar.xz
        rm -rf "$yublueflower_env/node" 2>/dev/null
        mkdir -p "$yublueflower_env/node"
        tar -C "$yublueflower_env/node" --strip-components=1 -xf /tmp/node.tar.xz
        rm -rf /tmp/node.tar.xz

        export PATH="$yublueflower_env/node/bin:$PATH"

        if ! grep -q "export PATH=\$HOME/yublueflower/yublueflower-env/node/bin:\$PATH" ~/.profile; then
            echo "export PATH=\$HOME/yublueflower/yublueflower-env/node/bin:\$PATH" >> ~/.profile
        fi
    fi
    
    go_version=$(go version 2>/dev/null | gawk '{print $3}' | sed 's/go//')
    required_go_version="1.26.3"

    if [[ -z "$go_version" ]] || [[ "$(printf '%s\n' "$go_version" "$required_go_version" | sort -V | tail -n1)" != "$go_version" ]]; then
        echo "Installing go.dev $required_go_version"

        wget -q https://go.dev/dl/go1.26.3.linux-amd64.tar.gz -O /tmp/go.tar.gz
        rm -rf "$yublueflower_env/go" 2>/dev/null
        mkdir -p "$yublueflower_env/go"
        tar -C "$yublueflower_env/go" --strip-components=1 -xzf /tmp/go.tar.gz
        rm -rf /tmp/go.tar.gz

        export GOROOT="$yublueflower_env/go"
        export GOPATH="$yublueflower_env/go/env"
        export PATH=$GOROOT/bin:$GOPATH/bin:$PATH

        if ! grep -q "export GOROOT=\$HOME/yublueflower/yublueflower-env/go" ~/.profile; then
            echo "export GOROOT=\$HOME/yublueflower/yublueflower-env/go" >> ~/.profile
        fi
        if ! grep -q "export GOPATH=\$HOME/yublueflower/yublueflower-env/go/env" ~/.profile; then
        echo "export GOPATH=\$HOME/yublueflower/yublueflower-env/go/env" >> ~/.profile
        fi
        if ! grep -q "export PATH=\$GOROOT/bin:\$GOPATH/bin:\$PATH" ~/.profile; then
            echo "export PATH=\$GOROOT/bin:\$GOPATH/bin:\$PATH" >> ~/.profile
        fi
    fi

    export GOPATH="$yublueflower_env/go/env"
    if [[ -x "$yublueflower_env/go/bin/go" ]]; then
        export GOROOT="$yublueflower_env/go"
        export PATH="$GOROOT/bin:$PATH"
    fi
    export PATH="$GOPATH/bin:$PATH"
    mkdir -p "$GOPATH/bin" "$GOPATH/src" "$GOPATH/pkg"

    go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest
    go install -v github.com/projectdiscovery/urlfinder/cmd/urlfinder@latest
    go install github.com/projectdiscovery/katana/cmd/katana@latest
    go install -v github.com/projectdiscovery/httpx/cmd/httpx@latest
    go install -v github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest
    go install github.com/charmbracelet/glow@latest
    
    clear
}

function yublueflower_help() {
    echo -e "\033[36mUsage:\033[0m"
    echo "  yublueflower --url http://php.testinvicti.com"
    echo "  yublueflower --brew < yu.txt"
    echo "  subfinder -d testinvicti.com | httpx | yublueflower --brew"
    echo ""
    echo -e "\033[36mOptions:\033[0m"
    echo "  --help                    Show help message"
    echo "  --session-header string[] Use --session-header to pass session (e.g., --session-header \"Cookie: laravel_session=...; XSRF-TOKEN=...\")"
    echo "  --brew                    Use --brew to pipe base URLs"
    echo "  --web-archives            Use --web-archives to time travel assets"
    echo "  --silent                  Keep crawl URL logs behaved"
    echo "  --extended-workflows      Use --extended-workflows to get high Bug Bounty rewards"
}

function yublueflower_1337c0de_log() {

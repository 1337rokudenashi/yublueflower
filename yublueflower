}

function yublueflower_1337brew_log() {
    local line display_time target
    while IFS= read -r line; do
        printf '%s\n' "$line" >> "$yublueflower_1337brew_raw"
        if [[ "$line" =~ ^\[([^]]+)\][[:space:]]+\[([^]]+)\][[:space:]]+\[([^]]+)\][[:space:]]+(.*)$ ]]; then
            display_time=$(date '+%H:%M:%S')
            target="${BASH_REMATCH[4]}"
            if [[ "${BASH_REMATCH[1]}" == "extract-urls" && "$target" == *" ["* ]]; then
                target="${target%% \[*} [...]"
            fi
            printf '\033[36m%s\033[0m  ◇ %s · %s · %s\n' "$display_time" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
            echo "           $target"
        else
            echo "$line"
        fi
    done
}

function yublueflower_cancel() {
    if [[ -n "$yublueflower_pid" ]]; then
        kill -TERM -- "-$yublueflower_pid" 2>/dev/null
        sleep 1
        kill -KILL -- "-$yublueflower_pid" 2>/dev/null
    fi

    [[ -n "$yublueflower_tmp" ]] && rm -rf "$yublueflower_tmp"
    [[ -n "$wrkp" ]] && rm -rf "$wrkp"
    [[ -n "$yublueflower_ipc" ]] && rm -rf "$yublueflower_ipc"
    [[ -n "$yublueflower_brew" ]] && rm -f "$yublueflower_brew"

    exit 130
}

function yublueflower_brew() {
    local url=""
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --url)
                if [[ -n "$2" && "$2" != -* ]]; then
                    url="$2"
                    shift 2
                else
                    shift
                fi
                ;;
            *)
                shift
                ;;
        esac
    done

    if [[ "$url" =~ ^https?:// ]]; then
        yublueflower_home="$HOME/yublueflower/yublueflower-cli"
        target_name="${url#http://}"
        target_name="${target_name#https://}"
        target_name=$(printf '%s' "$target_name" | sed -E 's/[^A-Za-z0-9._-]+/_/g; s/^_+//; s/_+$//')
        [[ -z "$target_name" ]] && target_name="target"
        wrkd="${target_name}_$(date '+%Y%m%d_%H%M%S')"
        wrkp="$yublueflower_home/$wrkd"
        yublueflower_tmp="/tmp/yublueflower-tmp/$wrkd"
        mkdir -p "$yublueflower_home" "$yublueflower_tmp"
        export DIR="$wrkd"
    fi
}


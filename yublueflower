                            ordered[++c] = kv[1]
                        }
                    }

                    for (i = 1; i <= c; i++) {

                        for (j = i + 1; j <= c; j++) {

                            if (ordered[i] > ordered[j]) {
                                tmp = ordered[i]
                                ordered[i] = ordered[j]
                                ordered[j] = tmp
                            }
                        }
                    }

                    for (i = 1; i <= c; i++) {
                        sig = sig "&" ordered[i]
                    }
                }

                if (!seen[sig]++) {
                    print
                }
